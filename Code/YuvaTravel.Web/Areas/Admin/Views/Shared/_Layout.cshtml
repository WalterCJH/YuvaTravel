    <script>
        function setDateTimePicker(block) {

            //datepicker
            $("input.js-datepicker", block).datetimepicker({
                format: "YYYY/MM/DD", locale: "zh-tw"
                , widgetPositioning: {
                    horizontal: 'auto',
                    vertical: 'bottom'
                }
            });
            $("input.js-datetimepicker", block).datetimepicker({
                format: "YYYY/MM/DD HH:mm", locale: "zh-tw"
                , widgetPositioning: {
                    horizontal: 'auto',
                    vertical: 'bottom'
                }
            });
            $("input.js-timepicker", block).datetimepicker({
                format: "HH:mm", locale: "zh-tw"
                , widgetPositioning: {
                    horizontal: 'auto',
                    vertical: 'bottom'
                }
            });
            $("input.js-daterangepicker").daterangepicker({
                autoUpdateInput: false,
                autoApply: true,
                locale: {
                    format: 'YYYY/MM/DD'
                }
            }).on("apply.daterangepicker", function (e, picker) {
                picker.element.val(picker.startDate.format(picker.locale.format) + '-' + picker.endDate.format(picker.locale.format));
            });
            $("input.js-datetimerangepicker").daterangepicker({
                timePicker: true,
                timePickerIncrement: 15,
                timePicker24Hour: true,
                autoUpdateInput: false,
                autoApply: true,
                locale: {
                    format: 'YYYY/MM/DD HH:mm'
                }
            }).on("apply.daterangepicker", function (e, picker) {
                picker.element.val(picker.startDate.format(picker.locale.format) + '-' + picker.endDate.format(picker.locale.format));
            });

            ////Date range picker
            //$('#reservation').daterangepicker()
            ////Date range picker with time picker
            //$('#reservationtime').daterangepicker({
            //    timePicker: true,
            //    timePickerIncrement: 30,
