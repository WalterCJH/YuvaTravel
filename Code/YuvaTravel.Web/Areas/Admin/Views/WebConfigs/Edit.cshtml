@model WebConfigEdit

@{
    ViewBag.Title = StrText.Edit + StrText.WebConfigs;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.WebPageInfo"
                    resource="@StrText.WebConfigs"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Edit)" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="WebConfigId" />

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">@StrText.Generally</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="GoRegister" class="control-label col-md-12"></label>
                            <input asp-for="GoRegister" class="form-control" />
                            <span asp-validation-for="GoRegister" class="text-danger"></span>
                            <div class="text-info"><small><cus-display-name asp-for="GoRegister" /> 不需要輸入推薦碼</small></div>
                            <div class="text-info"><small>ex:連結為 https://www.top1778.net/ag/seobet0100</small></div>
                            <div class="text-info"><small>欄位只需要輸入 https://www.top1778.net/ag/ 即可</small></div>
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
                <input type="submit" value="@StrText.Save" class="btn btn-success float-right">
            </div>
        </div>
    </section>
</form>

@section Scripts {
    }

