@model GuideCreateOrEdit

@{
    ViewBag.Title = StrText.Edit + StrText.Guides;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.Guides"
                    resource="@StrText.Guides"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Edit)" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="GuideId" />
    <section class="content">
        <partial name="_Form" model="Model" />
        <div class="row">
            <div class="col-12">
                <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
                <input type="submit" value="@StrText.Save" class="btn btn-success float-right">
            </div>
        </div>
    </section>
</form>

@section Scripts {
    <script src="~/Scripts/select2.js"></script>
    <script src="~/Scripts/select2/tag-select2.js"></script>
    <partial name="_FormScripts" />
}
