@model GuideFilter

@{
    ViewBag.Title = StrText.Guides + StrText.Index;
    var listData = ViewBag.ListData as IEnumerable<Guide>;
    object SetRouteValue(string sortBy, string sortDirection, int? pageNo = null)
    {
        var value = new { SortBy = sortBy, SortDirection = sortDirection, PageNo = pageNo, Keyword = Model.Keyword, IsActive = Model.IsActive, IsFeatured = Model.IsFeatured };
        return value;
    }
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.Guides"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Index)" method="get">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="form-group">
                <div class="row mb-3">
                    <div class="col-md-2 col-12">
                        <label asp-for="IsActive" class="control-label col-12"></label>
                        <select asp-for="IsActive" asp-items="Html.GetEnumSelectList<WhetherType>()" class="form-control">
                            <option value="">(請選擇)</option>
                        </select>
                    </div>
                    <div class="col-md-2 col-12">
                        <label asp-for="IsFeatured" class="control-label col-12"></label>
                        <select asp-for="IsFeatured" asp-items="Html.GetEnumSelectList<WhetherType>()" class="form-control">
                            <option value="">(請選擇)</option>
                        </select>
                    </div>
                    <div class="col-md-8 col-12">
                        <label asp-for="Keyword" class="control-label col-12"></label>
                        <input asp-for="Keyword" class="form-control" placeholder="名稱、英文名、代碼" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-secondary js-search-clear" title="清除搜尋欄位">
                    <i class="fas fa-broom"></i>
                </button>
                <button type="submit" class="btn btn-secondary">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
    </div>
</form>

<section class="content">

    @Html.PagedListPager(listData as IPagedList, (p) => Url.Action(nameof(StrText.Index), SetRouteValue(Model.SortBy, Model.SortDirection, p)),
    new PagedListRenderOptions
    {
        LiElementClasses = new string[] { "paginate_button page-item previous" },
        PageClasses = new string[] { "page-link" },
        DisplayLinkToFirstPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
        DisplayLinkToLastPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always
    })

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@StrText.Index</h3>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped projects">
                <thead>
                    <tr>
                        <th style="width:8%">
                            <cus-display-name for-type="@typeof(Guide)" property="IsActive" />
                        </th>
                        <th style="width:8%">
                            <cus-display-name for-type="@typeof(Guide)" property="IsFeatured" />
                        </th>
                        <th style="width:8%">
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("DisplaySeq", nameof(StrText.ASC)))"><i class="fas fa-sort-numeric-up"></i></a>
                            <cus-display-name for-type="@typeof(Guide)" property="DisplaySeq" />
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("DisplaySeq", nameof(StrText.DESC)))"><i class="fas fa-sort-numeric-down-alt"></i></a>
                        </th>
                        <th>
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Name", nameof(StrText.ASC)))"><i class="fas fa-sort-amount-up-alt"></i></a>
                            <cus-display-name for-type="@typeof(Guide)" property="Name" />
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Name", nameof(StrText.DESC)))"><i class="fas fa-sort-amount-down"></i></a>
                        </th>
                        <th>@StrText.Regions</th>
                        <th>
                            <cus-display-name for-type="@typeof(Guide)" property="Languages" />
                        </th>
                        <th>
                            <cus-display-name for-type="@typeof(Guide)" property="Rating" />
                        </th>
                        <th class="project-actions text-right" style="width:30%">
                            @if (ViewBag.IsCreate)
                            {
                                <a asp-action="@nameof(StrText.Create)" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus"></i> @StrText.Create
                                </a>
                            }
                            @if (ViewBag.IsImport)
                            {
                                <a asp-action="@nameof(StrText.Import)" class="btn btn-warning btn-sm">
                                    <i class="fas fa-file-import"></i> @StrText.Import
                                </a>
                            }
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in listData)
                    {
                        <tr>
                            <td><cus-display value="@item.IsActive" /></td>
                            <td><cus-display value="@item.IsFeatured" /></td>
                            <td><cus-display value="@item.DisplaySeq" /></td>
                            <td>
                                <strong>@item.Name</strong>
                                @if (!string.IsNullOrEmpty(item.NameEn))
                                {
                                    <span class="text-muted"> @item.NameEn</span>
                                }
                            </td>
                            <td>@string.Join("、", item.GuideRegions?.OrderBy(r => r.Region.DisplaySeq).Select(r => r.Region.Name) ?? Enumerable.Empty<string>())</td>
                            <td>@item.Languages</td>
                            <td>★ @item.Rating.ToString("0.0")</td>
                            <td class="project-actions text-right">
                                <a asp-controller="GuideRoutes" asp-action="Index" asp-route-guideId="@item.GuideId" class="btn btn-sm btn-outline-secondary" title="路線">
                                    <i class="fas fa-route"></i>
                                </a>
                                <a asp-controller="GuideReviews" asp-action="Index" asp-route-guideId="@item.GuideId" class="btn btn-sm btn-outline-secondary" title="評論">
                                    <i class="fas fa-star"></i>
                                </a>
                                <a asp-controller="GuideFaqs" asp-action="Index" asp-route-guideId="@item.GuideId" class="btn btn-sm btn-outline-secondary" title="FAQ">
                                    <i class="fas fa-question"></i>
                                </a>
                                @if (ViewBag.IsDetails)
                                {
                                    <a asp-action="@nameof(StrText.Details)" asp-route-id="@item.GuideId" class="btn btn-primary btn-sm">
                                        <i class="fas fa-folder"></i> @StrText.Details
                                    </a>
                                }
                                @if (ViewBag.IsEdit)
                                {
                                    <a asp-action="@nameof(StrText.Edit)" asp-route-id="@item.GuideId" class="btn btn-info btn-sm">
                                        <i class="fas fa-pencil-alt"></i> @StrText.Edit
                                    </a>
                                }
                                @if (ViewBag.IsDelete)
                                {
                                    <a asp-action="@nameof(StrText.Delete)" asp-route-id="@item.GuideId" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> @StrText.Delete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @Html.PagedListPager(listData as IPagedList, (p) => Url.Action(nameof(StrText.Index), SetRouteValue(Model.SortBy, Model.SortDirection, p)),
    new PagedListRenderOptions
    {
        LiElementClasses = new string[] { "paginate_button page-item previous" },
        PageClasses = new string[] { "page-link" },
        DisplayLinkToFirstPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
        DisplayLinkToLastPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always
    })
</section>
