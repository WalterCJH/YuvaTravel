@model GuideImport

@{
    ViewBag.Title = StrText.Import + StrText.Guides;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.Guides"
                    resource="@StrText.Guides"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Import)" method="post" enctype="multipart/form-data">
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="card card-primary">
                    <div class="card-header"><h3 class="card-title">@StrText.Generally</h3></div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-12">
                                <a asp-action="ImportEx" class="btn btn-warning">@StrText.UploadFileEx</a>
                                <small class="text-muted ml-2">下載範例檔後比照欄位填寫,以中文名+城市 / 代碼為比對鍵 (有就更新,沒有就新增)</small>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="File" class="control-label col-md-12"></label>
                            <input asp-for="File" class="form-control" />
                            <span asp-validation-for="File" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
                <input type="submit" value="@StrText.Upload" class="btn btn-success float-right">
            </div>
        </div>
    </section>
</form>
