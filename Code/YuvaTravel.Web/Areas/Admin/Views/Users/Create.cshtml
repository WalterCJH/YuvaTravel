@model UserCreateOrEdit

@{
    ViewBag.Title = StrText.Create + StrText.Users;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.UserInfo"
                    resource="@StrText.Users"
                    current="@ViewBag.Title" />
}


<form asp-action="@nameof(StrText.Create)" method="post" enctype="multipart/form-data">

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">@StrText.Generally</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <cus-checkbox asp-for="IsActive" />
                        </div>
                        <div class="form-group">
                            <cus-checkbox asp-for="LoginResetPassword" />
                        </div>
                        <div class="form-group">
                            <label asp-for="UserGroupId" class="control-label col-md-12"></label>
                            <select asp-for="UserGroupId" asp-items="@(new SelectList(ViewBag.UserGroupId, "UserGroupId", "Name"))" class="form-control">
                                <option value="">(請選擇)</option>
                            </select>
                            <span asp-validation-for="UserGroupId" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Name" class="control-label col-md-12"></label>
                            <div class="row">
                                <div class="col-6">
                                    <input asp-for="LastName" class="form-control" placeholder="姓氏" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                                <div class="col-6">
                                    <input asp-for="FirstName" class="form-control" placeholder="名字" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Salutation" class="control-label col-md-12"></label>
                            <select asp-for="Salutation" asp-items="@(new SelectList(ViewBag.Salutations))" class="form-control">
                                <option value="">(請選擇)</option>
                            </select>
                            <span asp-validation-for="Salutation" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Email" class="control-label col-md-12"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="_Password" class="control-label col-md-12"></label>
                            <input asp-for="_Password" class="form-control" />
                            <span asp-validation-for="_Password" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
                <input type="submit" value="@StrText.Save" class="btn btn-success float-right">
            </div>
        </div>
    </section>
</form>

@section Scripts {
    }

