@model GuideReviewCreateOrEdit
@{
    var guideSelectList = ViewBag.GuideSelectList as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<div class="row"><div class="col-12"><div asp-validation-summary="ModelOnly" class="text-danger"></div></div></div>

<div class="card card-primary">
    <div class="card-header"><h3 class="card-title">@StrText.Generally</h3></div>
    <div class="card-body">
        <div class="form-group">
            <label asp-for="GuideId" class="control-label col-md-12"></label>
            <select asp-for="GuideId" asp-items="guideSelectList" class="form-control"><option value="">(請選擇)</option></select>
            <span asp-validation-for="GuideId" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label asp-for="ReviewerName" class="control-label col-md-12"></label>
                <input asp-for="ReviewerName" class="form-control" />
                <span asp-validation-for="ReviewerName" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="ReviewerFrom" class="control-label col-md-12"></label>
                <input asp-for="ReviewerFrom" class="form-control" placeholder="例：台北" />
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Stars" class="control-label col-md-12"></label>
            <input asp-for="Stars" class="form-control" type="number" min="1" max="5" />
            <span asp-validation-for="Stars" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Content" class="control-label col-md-12"></label>
            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-4 form-group">
                <label asp-for="TripDate" class="control-label col-md-12"></label>
                <input asp-for="TripDate" class="form-control" type="date" />
            </div>
            <div class="col-md-4 form-group">
                <label asp-for="TripDays" class="control-label col-md-12"></label>
                <input asp-for="TripDays" class="form-control" />
            </div>
            <div class="col-md-4 form-group">
                <label asp-for="DisplaySeq" class="control-label col-md-12"></label>
                <input asp-for="DisplaySeq" class="form-control" />
            </div>
        </div>
    </div>
</div>
