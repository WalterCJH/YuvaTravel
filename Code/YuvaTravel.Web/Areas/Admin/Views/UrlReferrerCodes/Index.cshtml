@model UrlReferrerCodeFilter

@{
    ViewBag.Title = StrText.UrlReferrerCodes + StrText.Index;
    var listData = ViewBag.ListData as IEnumerable<UrlReferrerCode>;
    object SetRouteValue(string sortBy, string sortDirection, int? pageNo = null)
    {
        var value = new { SortBy = sortBy, SortDirection = sortDirection, PageNo = pageNo, Keyword = Model.Keyword };

        return value;
    }
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.WebPageInfo"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Index)" method="get">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="form-group">
                <div class="row">
                    <div class="col-md-9 col-12">
                        <label asp-for="Keyword" class="control-label col-12"></label>
                        <input asp-for="Keyword" class="form-control" placeholder="請輸入代碼、標題" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-secondary js-search-clear" title="清除搜尋欄位">
                    <i class="fas fa-broom"></i>
                </button>
                <button type="submit" class="btn btn-secondary">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
    </div>
</form>


<section class="content">

    <div class="row">
        <div class="col-12">
            <p>
                <button class="btn btn-warning" type="button" data-toggle="collapse" data-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
                    代碼使用說明
                </button>
            </p>
            <div class="collapse" id="collapseExample">
                <div class="card card-body">
                    test是追蹤碼<br />
                    網址最後面加上?rc=test<br />
                    Ex:<br />
                    @StrText.WebSiteUrl?rc=test <br />
                    @StrText.WebSiteUrl/ArticleCategory/Analyze?rc=test <br />
                    @StrText.WebSiteUrl/Article/lottery?rc=test <br />
                </div>
            </div>
        </div>
    </div>

    @Html.PagedListPager(listData as IPagedList, (p) => Url.Action(nameof(StrText.Index), SetRouteValue(Model.SortBy, Model.SortDirection, p)),
    new PagedListRenderOptions
    {
        LiElementClasses = new string[] { "paginate_button page-item previous" },
        PageClasses = new string[] { "page-link" },
        DisplayLinkToFirstPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
        DisplayLinkToLastPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always
    })

    <!-- Default box -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@StrText.Index</h3>

            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped projects">
                <thead>
                    <tr>
                        <th style="width: 10%">
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Code", nameof(StrText.ASC)))"><i class="fas fa-sort-alpha-up"></i></a>
                            <cus-display-name for-type="@typeof(UrlReferrerCode)" property="Code" />
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Code", nameof(StrText.DESC)))"><i class="fas fa-sort-alpha-down-alt"></i></a>
                        </th>
                        <th style="width: 20%">
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Name", nameof(StrText.ASC)))"><i class="fas fa-sort-amount-up-alt"></i></a>
                            <cus-display-name for-type="@typeof(UrlReferrerCode)" property="Name" />
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Name", nameof(StrText.DESC)))"><i class="fas fa-sort-amount-down"></i></a>
                        </th>
                        <th style="width: 20%">
                            <cus-display-name for-type="@typeof(UrlReferrerCode)" property="Description" />
                        </th>
                        <th class="project-actions text-right" style="width: 15%">
                            @if (ViewBag.IsCreate)
                            {
                                <a asp-action="@nameof(StrText.Create)" class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus"></i>
                                    @StrText.Create
                                </a>
                            }
                            @if (ViewBag.IsImport)
                            {
                                <a asp-action="@nameof(StrText.Import)" class="btn btn-warning btn-sm">
                                    <i class="fas fa-file-import"></i>
                                    @StrText.Import
                                </a>
                            }
                            @if (ViewBag.IsExport)
                            {
                                <a asp-action="@nameof(StrText.Export)" class="btn btn-warning btn-sm">
                                    <i class="fas fa-file-export"></i>
                                    @StrText.Export
                                </a>
                            }
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in listData)
                    {
                        <tr>
                            <td>
                                <cus-display value="@item.Code" />
                            </td>
                            <td>
                                <cus-display value="@item.Name" />
                            </td>
                            <td>
                                <cus-display value="@item.Description" />
                            </td>
                            <td class="project-actions text-right">
                                @if (ViewBag.IsDetails)
                                {
                                    <a asp-action="@nameof(StrText.Details)" asp-route-id="@item.UrlReferrerCodeId" class="btn btn-primary btn-sm">
                                        <i class="fas fa-folder"></i>
                                        @StrText.Details
                                    </a>
                                }
                                @if (ViewBag.IsEdit)
                                {
                                    <a asp-action="@nameof(StrText.Edit)" asp-route-id="@item.UrlReferrerCodeId" class="btn btn-info btn-sm">
                                        <i class="fas fa-pencil-alt"></i>
                                        @StrText.Edit
                                    </a>
                                }
                                @if (ViewBag.IsDelete)
                                {
                                    if (item.UrlReferrers.Count() == 0)
                                    {
                                        <a asp-action="@nameof(StrText.Delete)" asp-route-id="@item.UrlReferrerCodeId" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                            @StrText.Delete
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
            </table>
        </div>
        <!-- /.card-body -->
    </div>
    <!-- /.card -->


    @Html.PagedListPager(listData as IPagedList, (p) => Url.Action(nameof(StrText.Index), SetRouteValue(Model.SortBy, Model.SortDirection, p)),
    new PagedListRenderOptions
    {
        LiElementClasses = new string[] { "paginate_button page-item previous" },
        PageClasses = new string[] { "page-link" },
        DisplayLinkToFirstPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always,
        DisplayLinkToLastPage = X.PagedList.Mvc.Core.PagedListDisplayMode.Always
    })

</section>


