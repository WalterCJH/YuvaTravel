@model QuestionAnswer

@{
    ViewBag.Title = StrText.Delete + StrText.QuestionAnswers;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.WebPageInfo"
                    resource="@StrText.QuestionAnswers"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Delete)" method="post">
    <input type="hidden" asp-for="QuestionAnswerId" />

    <!-- Main content -->
    <section class="content js-disabled">
        <div class="row">
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">@StrText.Generally</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="DisplaySeq" class="control-label col-md-12"></label>
                            <input asp-for="DisplaySeq" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Title" class="control-label col-md-12"></label>
                            <input asp-for="Title" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Url" class="control-label col-md-12"></label>
                            <input asp-for="Url" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Content" class="control-label col-md-12"></label>
                            <cus-ckeditor asp-for="Content" />
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
                <input type="submit" value="@StrText.ConfirmDelete" class="btn btn-danger float-right js-delete-confirm">
            </div>
        </div>
    </section>
</form>
