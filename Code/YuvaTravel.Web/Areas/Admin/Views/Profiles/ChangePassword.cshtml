@model ChangePwdDto


@{
    ViewBag.Title = StrText.ChangePassword;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.Profiles"
                    current="@ViewBag.Title" />
}

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <partial name="~/Areas/Admin/Views/Profiles/_Profile.cshtml" />
            <!-- /.col -->

            <div class="col-md-9">
                <div class="card">
                    <div class="card-header p-2">
                        <ul class="nav nav-pills">
                            <li class="nav-item"><a class="nav-link" asp-action="Information" asp-controller="Profiles" asp-route-area="Admin">@StrText.Information</a></li>
                            <li class="nav-item"><a class="nav-link active" href="#pwds" data-toggle="tab">@StrText.ChangePassword</a></li>
                        </ul>
                    </div><!-- /.card-header -->
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane active" id="pwds">

                                <form asp-action="@nameof(StrText.ChangePassword)" method="post" class="form-horizontal">
                                    <input type="hidden" asp-for="UserGuid" />
                                    <input type="hidden" asp-for="IsNewUser" />
                                    @if (!Model.IsNewUser)
                                    {
                                        <div class="form-group row">
                                            <label asp-for="OldPassword" class="col-sm-2 col-form-label"></label>
                                            <div class="col-sm-10">
                                                <input asp-for="OldPassword" class="form-control" />
                                                <span asp-validation-for="OldPassword" class="text-danger"></span>
                                            </div>
                                        </div>
                                    }
                                    <div class="form-group row">
                                        <label asp-for="NewPassword" class="col-sm-2 col-form-label"></label>
                                        <div class="col-sm-10">
                                            <input asp-for="NewPassword" class="form-control" />
                                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label asp-for="ConfirmPassword" class="col-sm-2 col-form-label"></label>
                                        <div class="col-sm-10">
                                            <input asp-for="ConfirmPassword" class="form-control" />
                                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="form-group row">
                                        <div class="offset-sm-2 col-sm-10">
                                            <button type="submit" class="btn btn-success">確認更改</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <!-- /.tab-pane -->

                        </div>
                        <!-- /.tab-content -->

                    </div><!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>
<!-- /.content -->

@section Scripts {
    }

