@using System.IO
@model List<string>
@{
    Layout = null;

    int maxRequestLengthKb = 102400; // 100MB default

}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>CKEditor檔案管理</title>
    <link href="~/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="~/Content/ckeditorFileManager.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-fileinput/css/fileinput.min.css" rel="stylesheet" />
        <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/respond.min.js"></script>
    <script src="~/Scripts/fileinput.min.js"></script>
    <script src="~/Scripts/jquery.unveil.js"></script>
    <script>
        $(function () {
            //image lazy loading
            //$("img").unveil(200, function () {
            //    $(this).load(function () {
            //        $(this).removeClass("loading");
            //    });
            //});

            $("#input-701").fileinput({
                maxFileSize: @maxRequestLengthKb,
                uploadUrl: "@Url.Action("CKEditorFileUpload", "Images", new { area = "Admin" })",
                uploadAsync: false,
                allowedFileExtensions: ["jpg", "jpeg", "png", "gif", "webp"],
                browseClass: "btn btn-primary",
                showClose: false,
                autoReplace: true,
                maxFileCount: 5,
                fileActionSettings: {
                    showZoom: false
                }
            }).on('filebatchuploadsuccess', function (event, data, previewId, index) {
                var form = data.form, files = data.files, extra = data.extra,
                    response = data.response, reader = data.reader;

                //更新清單
                if (response !== undefined) {
                    var container = $("#FileContainer");
                    var files = response.files;
                    for (var i = 0; i < files.length; i++) {
                        var file = files[i];
                        var fileContentHtml = "<div class=\"FileItemContainer col-lg-2 col-md-3 col-sm-4 col-xs-6 col-12\" data-filename=\"" + file.FileName +
                            "\"><div class=\"text-end mb-2\"><input type=\"button\" class=\"btn btn-danger btn-block\" value=\"刪除\" /></div><p>" + file.FileName +"</p><img class=\"loading img-w-100\" src=\"" + file.FilePath + file.FileName +
                            "\" data-src=\"" + file.FilePath + file.FileName + "\" /></div>";


                    @*<div class="FileItemContainer col-lg-2 col-md-3 col-sm-4 col-xs-6 col-12" data-filename="@System.IO.Path.GetFileName(item)">
                        <div class="text-end mb-2">
                            <input type="button" class="btn btn-danger btn-block" value="刪除" />
                        </div>
                        <div>@System.IO.Path.GetFileName(item)</div>
                        <img class="loading img-w-100" src="@Url.Content(item)" data-src="@Url.Content(item)" />
                    </div>*@

                        container.prepend(fileContentHtml);
                        //container.find("img.loading").unveil(500, function () {
                            //$(this).load(function () {
                                //$(this).removeClass("loading");
                            //});
                        //});
                    }
                }

                //關閉上傳視窗#UploadModal
                $('#exampleModal').modal('hide');
            });

            //上傳檔案modal視窗 相關事件
            $('#exampleModal').on('hidden.bs.modal', function (e) {
                //初始化檔案上傳控制項
                $("#input-701").fileinput("clear");
            });

            //確定
            $(document).on("click", "#btnOk", function () {
                var selectedItem = $(".FileItemContainer.selected");
                if (selectedItem.length > 0) {
                    setSelectedUrl(selectedItem.find("img").attr("src"));
                } else {
                    if (confirm("尚未選取圖片\n按下「確定」關閉視窗\n按下「取消」重新選擇圖片"))
                        window.close();
                }
            });

            //取消
            $("#btnCancel").click(function () {
                window.close();
            });

            //圖片點選事件
            $(document).on("click", ".FileItemContainer > *:not(input:button)", function () {

                if (!$(this).parent(".FileItemContainer").hasClass("selected")) {
                    $(".FileItemContainer.selected").toggleClass("selected");
                }
                $(this).parent(".FileItemContainer").toggleClass("selected");
            });

            //搜尋文字輸入文字事件
            $(document).on("keyup","#searchText",function(event){
                $(".FileItemContainer.selected").removeClass("selected");

                var searchText=$(this).val();
                if(searchText===""){
                    $(".FileItemContainer").fadeIn(500);
                }else{
                    $(".FileItemContainer[data-filename*='"+searchText+"']").fadeIn(500);
                    $(".FileItemContainer:not([data-filename*='"+searchText+"'])").fadeOut(500);
                }
            });

            //清除輸入的搜尋文字
            $(document).on("click","#btnClearSearchText",function(){
                $("#searchText").val("");
                $(".FileItemContainer").fadeIn(500);
            });

            //刪除檔案
            $(document).on("click",".FileItemContainer > div > input:button",function(event){
                var container = $(this).closest(".FileItemContainer");
                var filename=container.attr("data-filename");
                if(confirm("確定刪除「"+filename+"」？")){
                    container.removeClass("selected");
                    $.post("@Url.Action("CKEditorFileDelete", "Images", new { area = "Admin" })",{fileName:filename},function(result){
                        // console.log("CKEditorFileDelete result:" + JSON.stringify(result, null, 2));
                        if(result.IsSuccess){
                            container.remove();
                        }else{
                            alert("刪除失敗-"+result.Message);
                        }
                    });
                }
            });
        });

        //回填資料至CKEditor設定欄位
        function setSelectedUrl(url) {
            var funcNum = $("#requestCKEditorFuncNum").val();
            window.opener.CKEDITOR.tools.callFunction(funcNum, url);
            window.close();
        }

    </script>
</head>
<body>

    <div class="row manager-title mb-5">
        <div class="container">
            <div class="row mb-4">
                <div class="col-12 my-3">
                    <div class="text-center"><i class="fas fa-folder-open"></i>&nbsp;圖片檔案管理</div>
                </div>
                <div class="offset-md-2 col-md-6 offset-0 col-6">
                    <div class="input-group">
                        <input type="text" id="searchText" class="form-control" placeholder="請輸入檔名" />
                        <div class="input-group-prepend">
                            <button type="button" id="btnClearSearchText" class="btn btn-warning" aria-label="Bold"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 col-4">
                    <!-- Button trigger modal -->
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        上傳檔案
                    </button>
                    @*<input type="button" id="btnUpload" class="btn btn-warning" value="上傳檔案" data-toggle="modal" data-target="#UploadModal" />*@
                    <input type="button" id="btnOk" class="btn btn-success" value="確定" />
                    <input type="button" id="btnCancel" class="btn btn-danger" value="取消" />
                </div>
            </div>

        </div>
    </div>


    <div class="container-fluid">
        <input type="hidden" id="requestCKEditorFuncNum" name="requestCKEditorFuncNum" value="@ViewData["CKEditorFuncNum"]" />
        <div class="row" role="main" id="FileContainer">
            @if (this.Model != null && this.Model.Count > 0)
            {
                foreach (var item in this.Model)
                {
                    <div class="FileItemContainer col-lg-2 col-md-3 col-sm-4 col-xs-6 col-12" data-filename="@System.IO.Path.GetFileName(item)">
                        <div class="text-end mb-2">
                            <input type="button" class="btn btn-danger btn-block" value="刪除" />
                        </div>
                        <div style="word-break: break-all;">@System.IO.Path.GetFileName(item)</div>
                        <img class="loading img-w-100" src="@Url.Content(item)" data-src="@Url.Content(item)" />
                    </div>
                }
            }
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">上傳檔案</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="file-loading">
                        <input id="input-701" name="file" type="file" data-browse-on-zone-click="true" multiple>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>


