@model SubscriberFilter

@{
    ViewBag.Title = StrText.Subscribers + StrText.Index;
    var listData = ViewBag.ListData as IEnumerable<Subscriber>;

    object SetRouteValue(string sortBy, string sortDirection, int? pageNo = null)
    {
        return new { SortBy = sortBy, SortDirection = sortDirection, PageNo = pageNo, Keyword = Model.Keyword, IsActive = Model.IsActive };
    }
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.WebPageInfo"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Index)" method="get">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="form-group row mb-3">
                <div class="col-md-3 col-12">
                    <label asp-for="IsActive" class="control-label col-12"></label>
                    <select asp-for="IsActive" asp-items="Html.GetEnumSelectList<WhetherType>()" class="form-control">
                        <option value="">(請選擇)</option>
                    </select>
                </div>
                <div class="col-md-9 col-12">
                    <label asp-for="Keyword" class="control-label col-12"></label>
                    <input asp-for="Keyword" class="form-control" placeholder="Email / 來源頁面 / IP" />
                </div>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-secondary js-search-clear"><i class="fas fa-broom"></i></button>
                <button type="submit" class="btn btn-secondary"><i class="fa fa-search"></i></button>
            </div>
        </div>
    </div>
</form>

<section class="content">
    @Html.PagedListPager(listData as IPagedList, (p) => Url.Action(nameof(StrText.Index), SetRouteValue(Model.SortBy, Model.SortDirection, p)),
        new PagedListRenderOptions { LiElementClasses = new[] { "paginate_button page-item previous" }, PageClasses = new[] { "page-link" } })

    <div class="card">
        <div class="card-header"><h3 class="card-title">@StrText.Index</h3></div>
        <div class="card-body p-0">
            <table class="table table-striped projects">
                <thead>
                    <tr>
                        <th style="width:6%">啟用</th>
                        <th>
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Email", nameof(StrText.ASC)))"><i class="fas fa-sort-alpha-up"></i></a>
                            Email
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("Email", nameof(StrText.DESC)))"><i class="fas fa-sort-alpha-down-alt"></i></a>
                        </th>
                        <th>
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("SubscribeTime", nameof(StrText.ASC)))"><i class="fas fa-sort-numeric-up"></i></a>
                            訂閱時間
                            <a href="@Url.Action(nameof(StrText.Index), SetRouteValue("SubscribeTime", nameof(StrText.DESC)))"><i class="fas fa-sort-numeric-down-alt"></i></a>
                        </th>
                        <th>來源頁</th>
                        <th>IP</th>
                        <th>UTM Source</th>
                        <th class="project-actions text-right" style="width:24%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in listData)
                    {
                        <tr>
                            <td><cus-display value="@item.IsActive" /></td>
                            <td><strong>@item.Email</strong></td>
                            <td>@item.SubscribeTime.ToString("yyyy/MM/dd HH:mm")</td>
                            <td><small class="text-muted">@item.SourcePath</small></td>
                            <td><small class="text-muted">@item.IpAddress</small></td>
                            <td><small>@item.UtmSource</small></td>
                            <td class="project-actions text-right">
                                @if (ViewBag.IsDetails)
                                {
                                    <a asp-action="@nameof(StrText.Details)" asp-route-id="@item.SubscriberId" class="btn btn-primary btn-sm">
                                        <i class="fas fa-folder"></i> @StrText.Details
                                    </a>
                                }
                                @if (ViewBag.IsEdit)
                                {
                                    <form asp-action="ToggleActive" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.SubscriberId" />
                                        @if (item.IsActive)
                                        {
                                            <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('將此 email 設為取消訂閱?');">
                                                <i class="fas fa-bell-slash"></i> 取消訂閱
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fas fa-bell"></i> 重新啟用
                                            </button>
                                        }
                                    </form>
                                }
                                @if (ViewBag.IsDelete)
                                {
                                    <a asp-action="@nameof(StrText.Delete)" asp-route-id="@item.SubscriberId" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> @StrText.Delete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @Html.PagedListPager(listData as IPagedList, (p) => Url.Action(nameof(StrText.Index), SetRouteValue(Model.SortBy, Model.SortDirection, p)),
        new PagedListRenderOptions { LiElementClasses = new[] { "paginate_button page-item previous" }, PageClasses = new[] { "page-link" } })
</section>
