@model RegionCreateOrEdit
@{
    ViewBag.Title = StrText.Edit + StrText.Regions;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.ArticleInfo"
                    resource="@StrText.Regions"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Edit)" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="RegionId" />
    <section class="content">
        <partial name="_Form" model="Model" />
        <div class="row"><div class="col-12">
            <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
            <input type="submit" value="@StrText.Save" class="btn btn-success float-right">
        </div></div>
    </section>
</form>
