@model YuvaTravel.Data.Dtos.Account.SetNewPasswordDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_NotLoginLayout.cshtml";
    ViewBag.Title = "設定新密碼";
}

<div class="login-box">
    <!-- /.login-logo -->
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="#" class="h1"><b>@StrText.AdminName</b></a>
        </div>
        <div class="card-body">
            @if (TempData["error-msg"] != null)
            {
                <div style="color:red;font-size:18pt;font-weight:900;text-align:center;margin-bottom:20px;">
                    @TempData["error-msg"]
                </div>
            }
            <p class="login-box-msg">@ViewBag.Title</p>
            <form method="post">
                <input type="hidden" asp-for="ForgetId" />
                <div class="input-group mb-3">
                    <input asp-for="NewPassword" class="form-control" placeholder="@Html.DisplayNameFor(model => model.NewPassword)" />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger col-12"></span>
                </div>
                <div class="input-group mb-3">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="@Html.DisplayNameFor(model => model.ConfirmPassword)" />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger col-12"></span>
                </div>
                <div class="row">
                    <div class="col-12 text-right">
                        <button type="submit" class="btn btn-primary">確認送出</button>
                    </div>
                </div>
            </form>
        </div>
        <!-- /.card-body -->
    </div>
    <!-- /.card -->
</div>
