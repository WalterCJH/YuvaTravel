@model YuvaTravel.Data.Dtos.Account.LoginDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_NotLoginLayout.cshtml";
    ViewBag.Title = $"後台{StrText.SignIn}";
}

<div class="login-box">
    <!-- /.login-logo -->
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="#" class="h1"><b>@StrText.AdminName</b></a>
        </div>
        <div class="card-body">
            @if (TempData["error-msg"] != null)
            {
                <div style="color:red;font-size:18pt;font-weight:900;text-align:center;margin-bottom:20px;">
                    @TempData["error-msg"]
                </div>
            }
            <p class="login-box-msg">@ViewBag.Title</p>
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="input-group mb-3">
                    <input asp-for="Email" class="form-control" placeholder="@Html.DisplayNameFor(model => model.Email)" />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-user"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Email" class="text-danger col-12"></span>
                </div>
                <div class="input-group mb-3">
                    <input asp-for="Password" class="form-control" placeholder="@Html.DisplayNameFor(model => model.Password)" />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger col-12"></span>
                </div>
                <div class="row">
                    <div class="col-8">
                        <div>
                            <a href="@Url.Action("ForgetPassword",new { e = Model.Email})" style="font-size:10pt;">忘記密碼</a>
                        </div>
                    </div>
                    <!-- /.col -->
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">@StrText.SignIn</button>
                    </div>
                    <!-- /.col -->
                </div>
            </form>

            <div class="social-auth-links text-center mt-2 mb-3">
                <form asp-action="ExternalLogin" asp-controller="Account" asp-area="Admin" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <button type="submit" class="btn btn-block btn-danger" name="provider" value="@ExternalLoginProvider.Google.ToString()">
                        <i class="fab fa-google-plus mr-2"></i> Google登入
                    </button>
                </form>
            </div>
            <div>
                <a href="@Url.Action("Privacy", "Account", new { Area = "Admin" })" target="_blank">隱私權條款</a>
            </div>
            <!-- /.social-auth-links -->
        </div>
        <!-- /.card-body -->
    </div>
    <!-- /.card -->
</div>
