@model WebMetaCreateOrEdit

@{
    ViewBag.Title = StrText.Edit + StrText.WebMetas;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.WebPageInfo"
                    resource="@StrText.WebMetas"
                    current="@ViewBag.Title" />
}

<form asp-action="@nameof(StrText.Edit)" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="WebMetaId" />
    <input type="hidden" asp-for="MetaImageUrl_" />

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">@StrText.Generally</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="Name" class="control-label col-md-12"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Url" class="control-label col-md-12"></label>
                            <input asp-for="Url" class="form-control" />
                            <span asp-validation-for="Url" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DisplaySeq" class="control-label col-md-12"></label>
                            <input asp-for="DisplaySeq" class="form-control" />
                            <span asp-validation-for="DisplaySeq" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <div class="col-md-6">
                <div class="card card-secondary">
                    <div class="card-header">
                        <h3 class="card-title">@StrText.Image</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <img src="@Model.MetaImageUrl_" class="img-adaptive" />
                        </div>
                        <div class="form-group">
                            <label asp-for="ImageFile" class="control-label col-md-12"></label>
                            <input asp-for="ImageFile" type="file" class="form-control" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
                <div class="card card-info">
                    <div class="card-header">
                        <h3 class="card-title">@StrText.Meta</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="OgType" class="control-label col-md-12"></label>
                            <cus-og-type asp-for="OgType" />
                            <span asp-validation-for="OgType" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="MetaTitle" class="control-label col-md-12"></label>
                            <input asp-for="MetaTitle" class="form-control" />
                            <span asp-validation-for="MetaTitle" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="MetaDescription" class="control-label col-md-12"></label>
                            <input asp-for="MetaDescription" class="form-control" />
                            <span asp-validation-for="MetaDescription" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Canonical" class="control-label col-md-12"></label>
                            <input asp-for="Canonical" class="form-control" />
                            <span asp-validation-for="Canonical" class="text-danger"></span>
                        </div>
                        <div class="form-group js-IsCanonicalAbsoluteUri">
                            <cus-checkbox asp-for="IsCanonicalAbsoluteUri" />
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
                <input type="submit" value="@StrText.Save" class="btn btn-success float-right">
            </div>
        </div>
    </section>
</form>

@section Scripts {
    <script src="~/Scripts/admin/canonical-change.js"></script>
}

