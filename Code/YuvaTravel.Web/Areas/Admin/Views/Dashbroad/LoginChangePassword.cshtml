@model YuvaTravel.Data.Dtos.Dashbroad.LoginChangePassword

@{
    Layout = "~/Areas/Admin/Views/Shared/_NotLoginLayout.cshtml";
    ViewBag.Title = "登入變更密碼";
}

<div class="login-box">
    <!-- /.login-logo -->
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="#" class="h1"><b>@StrText.AdminName</b></a>
        </div>
        <div class="card-body">
            <p class="login-box-msg">@Model.UserName @StrText.ResetPassword</p>
            <form method="post">
                <input type="hidden" asp-for="UserName" />
                <div class="input-group mb-3">
                    <label asp-for="Password" class="control-label col-md-12"></label>
                    <input asp-for="Password" class="form-control" />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger col-12"></span>
                </div>
                <div class="input-group mb-3">
                    <label asp-for="PasswordConfirm" class="control-label col-md-12"></label>
                    <input asp-for="PasswordConfirm" class="form-control" />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <span asp-validation-for="PasswordConfirm" class="text-danger col-12"></span>
                </div>
                <div class="row">
                    <div class="col-8">
                    </div>
                    <!-- /.col -->
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">確定送出</button>
                    </div>
                    <!-- /.col -->
                </div>
            </form>
        </div>
        <!-- /.card-body -->
    </div>
    <!-- /.card -->
</div>
