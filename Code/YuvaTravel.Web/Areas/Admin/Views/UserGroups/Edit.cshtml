@model UserGroupCreateOrEdit

@{
    ViewBag.Title = StrText.Edit + StrText.UserGroups;
}

@section breadcrumb{
    <cus-breadcrumb category="@StrText.UserInfo"
                    resource="@StrText.UserGroups"
                    current="@ViewBag.Title" />
}


<form asp-action="@nameof(StrText.Edit)" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="UserGroupId" />

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">@StrText.Generally</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group js-disabled">
                            <label asp-for="UserGroupId" class="control-label col-md-12"></label>
                            <input asp-for="UserGroupId" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="AuthorizeLevel" class="control-label col-md-12"></label>
                            <cus-enum-select asp-for="AuthorizeLevel" asp-items="@(new SelectList(ViewBag.AuthorizeLevel, "Value", "Key"))" class="form-control" />
                            <span asp-validation-for="AuthorizeLevel" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Name" class="control-label col-md-12"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>

            <div class="col-md-6">
                <partial name="~/Areas/Admin/Views/UserGroups/_UserGroupFuncProgram.cshtml" model="Model" />
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <a asp-action="@nameof(StrText.Index)" class="btn btn-secondary">@StrText.ReturnIndex</a>
                <input type="submit" value="@StrText.Save" class="btn btn-success float-right">
            </div>
        </div>
    </section>
</form>

@section Scripts {
    <script src="~/Scripts/check-all.js"></script>
}

