@model FaqDto
@{
    ViewBag.Title = "常見問答";
}

@section head_scripts {
    <link rel="stylesheet" href="~/Content/site/faq.css" />
}

<!-- ===================== HERO ===================== -->
<section class="faq-hero">
    <div class="container">
        <div class="faq-hero-inner">
            <div class="eyebrow">HELP · 我們可以幫你</div>
            <h1 class="faq-hero-title">有什麼問題？</h1>
            <p class="faq-hero-lede">關於媒合、費用、行程變更，或者你只是想多了解我們一點 — 答案大多在這裡。</p>

            <form class="faq-search" role="search" action="/Search" method="get">
                <span class="faq-search-icon" aria-hidden="true">⌕</span>
                <input type="search"
                       name="keyword"
                       placeholder="搜尋常見問題、關鍵字、嚮導名字..."
                       aria-label="搜尋常見問題" />
                <button type="submit" class="btn">搜尋</button>
            </form>

            <div class="faq-hero-suggest">
                <span class="suggest-label">大家在問</span>
                <a href="#popular" class="suggest-pill">媒合流程</a>
                <a href="#popular" class="suggest-pill">費用怎麼算</a>
                <a href="#popular" class="suggest-pill">可以改期嗎</a>
                <a href="#popular" class="suggest-pill">嚮導語言</a>
            </div>
        </div>
    </div>
</section>

<!-- ===================== POPULAR QUESTIONS (ACCORDION) ===================== -->
<section class="faq-popular" id="popular">
    <div class="container">
        <div class="section-head">
            <div class="titling">
                <div class="eyebrow">POPULAR · 大家最想知道</div>
                <h2 class="h-section">熱門問題</h2>
            </div>
            <span class="more-static">共 @Model.QuestionAnswers.Count 題 · 點擊展開</span>
        </div>

        @if (Model.QuestionAnswers.Count > 0)
        {
            <ul class="qa-list">
                @for (int i = 0; i < Model.QuestionAnswers.Count; i++)
                {
                    var qa = Model.QuestionAnswers[i];
                    var isOpen = i < 2;
                    <li class="qa-item @(isOpen ? "is-open" : "")">
                        <button class="qa-q" aria-expanded="@(isOpen ? "true" : "false")">
                            <span class="qa-num">@qa.ShowNumber</span>
                            <span class="qa-text">@qa.Title</span>
                            <span class="qa-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                                    <path d="M6 9 L12 15 L18 9" />
                                </svg>
                            </span>
                        </button>
                        <div class="qa-a">
                            @Html.Raw(qa.Content)
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p style="text-align:center; padding: 40px 0; color: rgba(0,0,0,.45);">目前沒有常見問答。</p>
        }
    </div>
</section>

<!-- ===================== STILL NEED HELP ===================== -->
<section class="faq-contact">
    <div class="container">
        <div class="contact-card">
            <div class="contact-text">
                <div class="eyebrow eyebrow-onDark">STILL NEED HELP · 沒找到答案？</div>
                <h2 class="contact-title">直接寫信給我們</h2>
                <p class="contact-lede">每一封信都會由真人讀完。<br />通常 1 個工作天內回覆，我們也樂意聽你說旅行的事。</p>
            </div>
            <div class="contact-actions">
                <a href="mailto:service@@yuvatravel.com" class="btn btn-on-dark">寫信給我們 →</a>
                <a href="@StrPath.Facebook" class="contact-secondary" target="_blank" rel="noopener">或在 Facebook 私訊</a>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        (function () {
            document.querySelectorAll('.qa-item').forEach(function (item) {
                var btn = item.querySelector('.qa-q');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    var nowOpen = !item.classList.contains('is-open');
                    item.classList.toggle('is-open', nowOpen);
                    btn.setAttribute('aria-expanded', nowOpen ? 'true' : 'false');
                });
            });
        })();
    </script>
}
