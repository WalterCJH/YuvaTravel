<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>
    <target name="TraceFile" xsi:type="File" fileName="${basedir}/NLogs/${shortdate}/Trace.log"
        layout="${date}| ${level} | ${message}" encoding="utf-8"/>
    <target name="DebugFile" xsi:type="File" fileName="${basedir}/NLogs/${shortdate}/Debug.log"
        layout="${date}| ${level} | ${message}" encoding="utf-8"/>
    <target name="InfoFile" xsi:type="File" fileName="${basedir}/NLogs/${shortdate}/Info.log"
        layout="${date}| ${level} | ${message}" encoding="utf-8"/>
    <target name="WarnFile" xsi:type="File" fileName="${basedir}/NLogs/${shortdate}/Warn.log"
        layout="${date}| ${level} | ${message}" encoding="utf-8"/>
    <target name="ErrorFile" xsi:type="File" fileName="${basedir}/NLogs/${shortdate}/Error.log"
        layout="${date}| ${level} | ${message}" encoding="utf-8"/>
    <target name="FatalFile" xsi:type="File" fileName="${basedir}/NLogs/${shortdate}/fatal.log"
        layout="${date}| ${level} | ${message}" encoding="utf-8"/>
  </targets>

  <rules>
    <logger name="*" levels="Trace" writeTo="TraceFile" />
    <logger name="*" levels="Debug" writeTo="DebugFile" />
    <logger name="*" levels="Info" writeTo="InfoFile" />
    <logger name="*" levels="Warn" writeTo="WarnFile" />
    <logger name="*" levels="Error" writeTo="ErrorFile" />
    <logger name="*" level="Fatal" writeTo="FatalFile" />
    <!-- Suppress noisy ASP.NET Core logs -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
  </rules>
</nlog>
